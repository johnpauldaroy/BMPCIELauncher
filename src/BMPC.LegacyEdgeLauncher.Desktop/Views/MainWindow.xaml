<Window x:Class="BMPC.LegacyEdgeLauncher.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BMPC.LegacyEdgeLauncher.Desktop.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BMPC IE Launcher"
        Icon="/Assets/coop.ico"
        Height="760" Width="1120" MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    <Grid>
        <!-- Main content -->
        <DockPanel LastChildFill="True">
            <!-- Status header -->
            <Border DockPanel.Dock="Top" Background="White" Padding="20,14" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Image Source="/Assets/coop.png" Width="54" Height="42" Stretch="Uniform"
                               Margin="0,0,10,0" SnapsToDevicePixels="True" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ApplicationTitle}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Organization}" Foreground="#6B7280" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Tiles stay on one row; if the window is too narrow the header scrolls
                         horizontally instead of wrapping into a broken two-row layout. -->
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <StackPanel Margin="16,0,0,0" MinWidth="100">
                                <TextBlock Text="IE Mode Policy" Foreground="#6B7280" FontSize="11" />
                                <TextBlock Text="{Binding IeModeEnabled}" FontWeight="SemiBold"
                                           Foreground="{Binding IeModeEnabled, Converter={StaticResource BoolToOkBrush}}" />
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0" MinWidth="100">
                                <TextBlock Text="Restart Required" Foreground="#6B7280" FontSize="11" />
                                <TextBlock Text="{Binding RestartRequired}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0" MinWidth="110">
                                <TextBlock Text="Edge Version" Foreground="#6B7280" FontSize="11" />
                                <TextBlock Text="{Binding EdgeVersion}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Margin="16,0,0,0" MinWidth="80">
                                <TextBlock Text="Applications" Foreground="#6B7280" FontSize="11" />
                                <TextBlock Text="{Binding RegisteredApplications}" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings menu: admin modules moved out of the sidebar into a gear dropdown. -->
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Width="40" Height="40" Margin="0,0,4,0"
                                Command="{Binding RefreshConfigurationCommand}"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="Refresh configuration">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="19" Foreground="#374151"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#F3F4F6" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#E5E7EB" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <ToggleButton x:Name="SettingsToggle" Grid.Column="1" Width="40" Height="40"
                                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                                      ToolTip="Settings">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="20" Foreground="#374151"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#F3F4F6" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#E5E7EB" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <Popup Grid.Column="1" IsOpen="{Binding IsChecked, ElementName=SettingsToggle}"
                               PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Bottom"
                               HorizontalOffset="-160" VerticalOffset="4"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1"
                                    Width="200" Padding="6">
                                <Border.Effect>
                                    <DropShadowEffect Color="#1F2937" BlurRadius="16" ShadowDepth="2"
                                                      Direction="270" Opacity="0.18" />
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <!-- Menu-item buttons: full-width, left-aligned, glyph + label. -->
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                            <Setter Property="Padding" Value="10,8" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Foreground" Value="#1F2937" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ib" Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ib" Property="Background" Value="#F3F4F6" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                </StackPanel.Resources>

                                    <Button Click="ApplicationsMenuItem_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       Foreground="#1D4ED8" Width="26" VerticalAlignment="Center" />
                                            <TextBlock Text="Applications" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="SetupMenuItem_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       Foreground="#1D4ED8" Width="26" VerticalAlignment="Center" />
                                            <TextBlock Text="Policies &amp; Setup" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="DiagnosticsMenuItem_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                       Foreground="#1D4ED8" Width="26" VerticalAlignment="Center" />
                                            <TextBlock Text="Diagnostics" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" Margin="0" />
        </DockPanel>
    </Grid>
</Window>
