<UserControl x:Class="BMPC.LegacyEdgeLauncher.Desktop.Views.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BMPC.LegacyEdgeLauncher.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LauncherViewModel}">
    <DockPanel LastChildFill="True" Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Approved systems" Style="{StaticResource SectionHeader}" />
        <TextBlock DockPanel.Dock="Top" Text="No applications are registered yet. An administrator can add one from the Applications page."
                   Foreground="#6B7280" Margin="0,0,0,8"
                   Visibility="{Binding HasNoApplications, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#374151" Margin="0,10,0,0"
                   TextWrapping="Wrap" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.Resources>
                    <!-- Text-style "OPEN SYSTEM" link that mimics the reference design's
                         hyperlink-with-arrow rather than a filled button. -->
                    <Style x:Key="OpenSystemLink" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Foreground" Value="#1D4ED8" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9CA3AF" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Resources>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AppTileViewModel}">
                        <Border x:Name="TileRoot" Width="330" Height="210" Margin="0,0,20,20" Background="White" CornerRadius="10"
                                BorderBrush="#E5E7EB" BorderThickness="1" Padding="24,22"
                                SnapsToDevicePixels="True"
                                AllowDrop="True" Cursor="Hand"
                                ToolTip="Click to open · drag to rearrange"
                                PreviewMouseLeftButtonDown="Tile_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="Tile_PreviewMouseLeftButtonUp"
                                PreviewMouseMove="Tile_PreviewMouseMove"
                                Drop="Tile_Drop"
                                DragOver="Tile_DragOver"
                                DragLeave="Tile_DragLeave">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#1F2937" BlurRadius="14" ShadowDepth="2"
                                                              Direction="270" Opacity="0.10" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- Lift the card on hover so it reads as clickable. -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#93C5FD" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#1D4ED8" BlurRadius="18" ShadowDepth="3"
                                                                      Direction="270" Opacity="0.22" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="False">
                                <!-- Icon -->
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Icon}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="34"
                                           Foreground="#1D4ED8" />
                                <!-- Title -->
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Name}"
                                           Foreground="#1E3A8A" FontWeight="Bold" FontSize="17"
                                           Margin="0,16,0,0" TextTrimming="CharacterEllipsis" />
                                <!-- Subtitle -->
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Description}"
                                           Foreground="#6B7280" FontSize="13" Margin="0,10,0,0"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" />
                                <!-- Open link, pinned to the bottom of the card -->
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource OpenSystemLink}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="OPEN SYSTEM" />
                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Margin="6,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
