<UserControl x:Class="BMPC.LegacyEdgeLauncher.Desktop.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BMPC.LegacyEdgeLauncher.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ApplicationsViewModel}">
    <DockPanel LastChildFill="True" Margin="20">
        <DockPanel DockPanel.Dock="Top">
            <!-- Buttons dock first so they always reserve their width; the title
                 ellipsises instead of pushing them off the right edge. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsEnabled="{Binding IsAdministrator}">
                <Button Content="Add" Command="{Binding AddApplicationCommand}" />
                <Button Content="Publish site list" Command="{Binding PublishCommand}"
                        Margin="0" Background="#2563EB" Foreground="White" />
            </StackPanel>
            <TextBlock Text="Applications" Style="{StaticResource SectionHeader}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Foreground="#B45309" Margin="0,0,0,8"
                   Text="Standard user mode: applications are read-only. Run as administrator to make changes."
                   Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#374151"
                   Margin="0,10,0,0" TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- MinWidth keeps the list usable rather than letting the fixed-width
                     edit form squeeze it to nothing on a narrow window. -->
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Application list -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding Applications}"
                      SelectedItem="{Binding SelectedApplication}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" Background="White" RowHeaderWidth="0"
                      CanUserAddRows="False" Margin="0,0,12,0"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="90" />
                    <DataGridTextColumn Header="Environment" Binding="{Binding Environment}" Width="Auto" MinWidth="90" />
                    <DataGridTextColumn Header="Site-list rule" Binding="{Binding SiteListRuleUrl}" Width="*" MinWidth="160" />
                    <DataGridTextColumn Header="Browser" Binding="{Binding LaunchBrowserDisplayName}" Width="Auto" MinWidth="110" />
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="Auto" MinWidth="60" />
                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            IsEnabled="{Binding DataContext.IsAdministrator, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                    <Button Content="Edit" MinWidth="0" Padding="8,2"
                                            Command="{Binding DataContext.EditApplicationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Delete" MinWidth="0" Padding="8,2"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Edit form -->
            <Border Grid.Column="1" MinWidth="300" MaxWidth="360" Background="White" CornerRadius="8"
                    BorderBrush="#E5E7EB" BorderThickness="1" Padding="16"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding EditModel}">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="Application name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Dashboard icon" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding DataContext.Icons, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedValuePath="Key" SelectedValue="{Binding IconKey}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Foreground="#1D4ED8"
                                                   VerticalAlignment="Center" Width="24" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Description (shown on the dashboard card)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="80" />

                        <TextBlock Text="Environment" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding DataContext.Environments, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding Environment}" />

                        <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Path rule (optional, e.g. /barbazampc)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding PathRule, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Leave blank for the whole host. If that host is already registered, the URL path is used automatically."
                                   Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="Browser" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding DataContext.Browsers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                  SelectedValue="{Binding LaunchBrowser}" />
                        <TextBlock Text="Legacy Internet Explorer may be disabled on Windows 10 and 11. Edge (IE mode) is the supported choice."
                                   Foreground="#B45309" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="Compatibility mode" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding DataContext.CompatModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding CompatibilityMode}" />

                        <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" Margin="0,10,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Save" Background="#2563EB" Foreground="White"
                                    MinWidth="0"
                                    Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Grid.Column="1" Content="Cancel" MinWidth="0" Margin="0"
                                    Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
