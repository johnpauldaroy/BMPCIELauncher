<UserControl x:Class="BMPC.LegacyEdgeLauncher.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BMPC.LegacyEdgeLauncher.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DiagnosticsViewModel}">
    <DockPanel LastChildFill="True" Margin="20">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Run diagnostics" Command="{Binding RunCommand}"
                        Background="#2563EB" Foreground="White" />
                <Button Content="Copy report" Command="{Binding CopyReportCommand}" />
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="#374151"
                   Margin="0,10,0,0" TextWrapping="Wrap" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1"
                                Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0"
                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" FontSize="11"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CheckName}" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock Text="{Binding FriendlyMessage}" Foreground="#374151"
                                           TextWrapping="Wrap" Margin="20,4,0,0" />
                                <TextBlock Text="{Binding RecommendedAction}" Foreground="#B45309"
                                           TextWrapping="Wrap" Margin="20,4,0,0"
                                           Visibility="{Binding RecommendedAction, Converter={StaticResource NullOrEmptyToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
